{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caster",
  "identifier": "app.zerofriction.desktopnative",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Caster",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Utility",
    "macOS": {
      "frameworks": [
        "../vendor/syphon/Syphon.framework"
      ],
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "resources": {
      "icons/Assets.car": "Assets.car"
    }
  }
}
