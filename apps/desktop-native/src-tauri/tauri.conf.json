{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zero-Friction Local Cast Native",
  "identifier": "app.zerofriction.desktopnative",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zero-Friction Local Cast",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "macOS": {
      "frameworks": [
        "../vendor/syphon/Syphon.framework"
      ],
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
