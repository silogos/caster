<?xml version="1.0" encoding="utf-8"?>
<!-- Caster's mark: a screen with two waves from its corner, the same mark
     that sits beside the receiver's nameplate (designs/app-icon.figcraft).
     Drawn in its 24-unit grid, scaled 2× to 48 of the 108 units: inside the
     adaptive icon's 66-unit safe zone at the tile's 22/40 proportion. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2"
        android:scaleY="2"
        android:translateX="30"
        android:translateY="30">

        <!-- Screen -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z" />

        <!-- Two waves from the bottom-left corner -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M3,15 a4,4 0 0 1 4,4" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M3,11 a8,8 0 0 1 8,8" />
    </group>
</vector>
