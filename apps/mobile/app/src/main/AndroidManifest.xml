<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebSocket signaling to the desktop (Phase 3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal permission (granted at install). TikTok's cast holds it and
         this ROM appears to gate the REMOTE_SUBMIX loopback route on it —
         the stereo capture path on ROMs whose playback-capture remix is
         broken (found live 2026-11-04, issue #101). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- QR code scanning only (Phase 3); requested at runtime on the scan screen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Screen cast foreground service (Phase 5) — Android14+ requires the
         mediaProjection-type FGS before the virtual display is created. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Mic cast (Phase8) while the app is backgrounded: Android 11+ allows
         background microphone only through a `microphone`-typed foreground
         service (found live on Android 16: without it the system mutes the mic
         the moment the app leaves the foreground — screen and game audio kept
         playing, mic went silent). Android 14+ requires this permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Cast-in-progress notification (FGS visibility on 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Game audio (Phase 7): the platform requires RECORD_AUDIO to build the
         playback-capture AudioRecord (and the WebRTC ADM), even though no
         microphone sample is ever captured; requested at runtime before a cast. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Wi-Fi radio hold for the cast's lifetime (issue #86): WifiLock needs
         WAKE_LOCK. Keeps the radio out of aggressive power-save while the
         caster app is backgrounded during a game — one half of surviving
         transient mid-game UDP outages. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Hotspot pairing mode (issue #96, ADR-011): startLocalOnlyHotspot is
         gated on location below Android 13 and on the nearby-devices
         permission from 13 (the Wi-Fi API migration); neverForLocation
         asserts we derive no location from it. A local-only hotspot shares
         no internet — the LAN-only posture holds. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:allowAudioPlaybackCapture="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalCast">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Minimal Phase5 skeleton (service/CastService.kt): owns the
             MediaProjection + media pipeline; full lifecycle is Phase6. The
             `microphone` type is enabled at runtime only while the mic session
             is on (and RECORD_AUDIO is granted) — CastForegroundTypes. -->
        <service
            android:name=".service.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>

</manifest>
